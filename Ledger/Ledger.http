#    "idempotencyKey": "test-correction-001",
#    "lines": [
#      { "accountNumber": 2110, "direction": 1,  "amount": 30.00, "customerId": "11111111-1111-1111-1111-111111111111" },
#      { "accountNumber": 2220, "direction": -1, "amount": 30.00, "customerId": null }
#    ]
#  }'
POST http://localhost:5000/api/admin/corrections
Content-Type: application/json

{
  "reason": "test_bug_fix",
  "description": "Moving 30 EUR from Alice viban to review suspense for testing",
  "requestedBy": "ops@broker",
  "currency": "EUR",
  "correctsTransactionId": null,
  "idempotencyKey": "test-correction-001",
  "lines": [
    {
      "accountNumber": 2110,
      "direction": 1,
      "amount": 30.00,
      "customerId": "11111111-1111-1111-1111-111111111111"
    },
    {
      "accountNumber": 2220,
      "direction": -1,
      "amount": 30.00,
      "customerId": null
    }
  ]
}

