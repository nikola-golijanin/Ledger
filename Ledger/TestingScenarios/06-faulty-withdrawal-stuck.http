### Step 1 — clean state
POST https://localhost:7100/api/testing/reset

### Step 2 — Alice needs funds
POST https://localhost:7100/api/testing/inject-deposit
Content-Type: application/json

{
  "customerIban": "DE89370400440532013000",
  "customerName": "Alice Muller",
  "amount": 200.00
}

###
# Wait ~5 seconds.

### Step 3 — trigger the faulty withdrawal (Instant SEPA)
POST https://localhost:7100/api/testing/faulty-withdrawal
Content-Type: application/json

{
  "customerId": "11111111-1111-1111-1111-111111111111",
  "amount": 50.00,
  "sepaType": 2
}


### Note transactionId = $TX_ID

### Step 4 — verify books are balanced but suspense is non-zero
# psql:
# SELECT a.code,
#   CASE WHEN a.type IN ('Asset','Expense') THEN SUM(je.direction*je.amount)
#        ELSE -SUM(je.direction*je.amount) END AS natural
# FROM ledger.accounts a
# JOIN ledger.journal_entries je ON je.account_number = a.number
# WHERE a.code IN ('bank.pooling','customer.viban','suspense.withdrawal')
# GROUP BY a.code, a.type
# ORDER BY a.code;
#
# Expected:
#   bank.pooling = 200 (unchanged — bank never told)
#   customer.viban (Alice) = 150 (200 - 50)
#   suspense.withdrawal = 50 (stuck!)
#
# SELECT SUM(direction * amount) AS drift FROM ledger.journal_entries;
# Expected: 0 (books balance, transaction is internally consistent)

### Step 5 — confirm the mock bank statement is empty (bank wasn't told)
# Mock bank state can't be queried via SQL — visible only in app memory.
# Trust: after a faulty withdrawal, no outgoing entry exists on the bank side.

### Step 6 — wait ~30-45 seconds. Check the application logs.
# Expected to see (around the SLA mark):
#
#   STUCK IN SUSPENSE: Account=2210 TxId=<id> Net=-50 Age=00:00:30 SLA=00:00:30
#
# This is the Suspense Aging Monitor flagging the stuck transaction.

### Step 7 — confirm transaction is still Processing
# SELECT id, status, created_at, NOW() - created_at AS age
# FROM ledger.transactions
# WHERE id = '$TX_ID';
# Expected: status = 'Processing', age growing forever

### Step 8 — observe that the books are STILL internally consistent
# SELECT SUM(direction * amount) AS drift FROM ledger.journal_entries;
# Still 0. The faulty withdrawal is a process error, not a bookkeeping error.
# Reconciliation passes; only the aging monitor catches this.