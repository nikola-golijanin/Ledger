### Step 1 — clean state
POST https://localhost:7100/api/testing/reset

# Step 2 — Simulate the bug by editing the v1 rule's lines.
# We're pretending v1 was deployed with a wrong credit account.
# Run this in sql:
#
#   BEGIN;
#   UPDATE ledger.posting_rule_lines
#   SET account_number = 2220,        -- suspense.deposit.review
#       carries_customer_id = false   -- and forget to attribute to customer
#   WHERE direction = -1
#     AND posting_rule_id = (
#       SELECT id FROM ledger.posting_rules
#       WHERE event_type = 'deposit.detected.clean_match' AND is_active
#     );
#   COMMIT;
#
# Verify the bug is in place:
#
#   SELECT prl.account_number, prl.direction, prl.carries_customer_id
#   FROM ledger.posting_rule_lines prl
#   JOIN ledger.posting_rules pr ON pr.id = prl.posting_rule_id
#   WHERE pr.event_type = 'deposit.detected.clean_match' AND pr.is_active
#   ORDER BY prl.sequence;
#
# Expected:
#   1110, +1, false       (debit pooling — correct)
#   2220, -1, false       (credit suspense.deposit.review — BUG)

### Step 3 — Three deposits flow under the buggy rule.
# Each will credit account 2220 instead of Alice's vIBAN.
# Deposit 1
POST https://localhost:7100/api/testing/inject-deposit
Content-Type: application/json

{
  "customerIban": "DE89370400440532013000",
  "customerName": "Alice Muller",
  "amount": 100.00
}

### Deposit 2
POST https://localhost:7100/api/testing/inject-deposit
Content-Type: application/json

{
  "customerIban": "DE89370400440532013000",
  "customerName": "Alice Muller",
  "amount": 50.00
}

### Deposit 3
POST https://localhost:7100/api/testing/inject-deposit
Content-Type: application/json

{
  "customerIban": "DE89370400440532013000",
  "customerName": "Alice Muller",
  "amount": 75.00
}

### Step 4 — Verify the books are wrong.
# Alice has 0 balance even though 225 EUR was deposited.
# Expected balances:
#   bank.pooling = 225 (correct — money is there)
#   customer.viban (Alice) = 0 (WRONG — should be 225)
#   suspense.deposit.review = 225 (WRONG — money parked here by mistake)
#
# Run in sql:
#
#   SELECT a.code,
#     CASE WHEN a.type IN ('Asset','Expense') THEN SUM(je.direction*je.amount)
#          ELSE -SUM(je.direction*je.amount) END AS natural
#   FROM ledger.accounts a
#   JOIN ledger.journal_entries je ON je.account_number = a.number
#   WHERE a.code IN ('bank.pooling','customer.viban','suspense.deposit.review')
#   GROUP BY a.code, a.type
#   ORDER BY a.code;
#
# Note: reconciliation still passes — books are internally balanced.
#   SELECT SUM(direction * amount) AS drift FROM ledger.journal_entries;
#   Expected: 0

### Step 5 — Discover the bug.
# We post v2 of the rule with the correct accounts.

POST https://localhost:7100/api/admin/posting-rules
Content-Type: application/json

{
  "eventType": "deposit.detected.clean_match",
  "description": "v2 - fix bug, credit customer.viban with customer attribution",
  "lines": [
    {
      "accountNumber": 1110,
      "direction": 1,
      "carriesCustomerId": false
    },
    {
      "accountNumber": 2110,
      "direction": -1,
      "carriesCustomerId": true
    }
  ]
}

### Step 6 — Verify versioning state in psql:
#
#   SELECT version, is_active, effective_from, effective_until
#   FROM ledger.posting_rules
#   WHERE event_type = 'deposit.detected.clean_match'
#   ORDER BY version;
#
# Expected:
#   v1: is_active=false, effective_until=now-ish
#   v2: is_active=true, effective_until=NULL

### Step 7 — Run the diff to find affected events.
GET https://localhost:7100/api/admin/posting-rules/diff/deposit.detected.clean_match

#
# Expected response:
#   totalEvents: 3
#   differingEvents: 3
#   currentRuleVersion: 2
#   events: [...] (3 entries, each with differs=true, ruleVersionUsed=1)
#
# Each event's "actual" shows the buggy posting (1110 +1, 2220 -1, no customer).
# Each event's "expected" shows what v2 would produce (1110 +1, 2110 -1 with Alice's id).

### Step 8 — Post corrections. One per affected event.
# Each correction moves the relevant amount from suspense.deposit.review (2220)
# to Alice's customer.viban (2110).
#
# We use idempotency keys so each correction is unique and safe to retry.

### Correction for Deposit 1 (100 EUR)
POST https://localhost:7100/api/admin/corrections
Content-Type: application/json

{
  "reason": "v1_bug_credit_wrong_account",
  "description": "Apr deposit 100 EUR was credited to suspense.deposit.review instead of Alice viban",
  "requestedBy": "ops@broker",
  "currency": "EUR",
  "idempotencyKey": "bug-fix-100-eur-deposit",
  "lines": [
    {
      "accountNumber": 2220,
      "direction": 1,
      "amount": 100.00,
      "customerId": null
    },
    {
      "accountNumber": 2110,
      "direction": -1,
      "amount": 100.00,
      "customerId": "11111111-1111-1111-1111-111111111111"
    }
  ]
}

