### Step 9 — Verify the books are now correct.
# Run in psql:
#
#   SELECT a.code,
#     CASE WHEN a.type IN ('Asset','Expense') THEN SUM(je.direction*je.amount)
#          ELSE -SUM(je.direction*je.amount) END AS natural
#   FROM ledger.accounts a
#   JOIN ledger.journal_entries je ON je.account_number = a.number
#   WHERE a.code IN ('bank.pooling','customer.viban','suspense.deposit.review')
#   GROUP BY a.code, a.type
#   ORDER BY a.code;
#
# Expected:
#   bank.pooling = 225
#   customer.viban (Alice) = 225 (cleaned up)
#   suspense.deposit.review = 0 (cleared by corrections)
#
# Reconciliation:
#   SELECT SUM(direction * amount) AS drift FROM ledger.journal_entries;
#   Expected: 0

### Step 10 — Audit the corrections in psql:
#
#   SELECT id, type, amount, correction_reason, requested_by, created_at
#   FROM ledger.transactions
#   WHERE type = 'Correction'
#   ORDER BY created_at;
#
# Expected: 3 rows. Each with:
#   type = Correction
#   amount = 100, 50, 75
#   correction_reason = v1_bug_credit_wrong_account
#   requested_by = ops@ broker

### Step 11 — Confirm the audit chain end-to-end:
#
#   SELECT
#     ae.event_type,
#     pr.version AS rule_version,  -- NULL for corrections
#     a.code,
#     je.direction,
#     je.amount,
#     je.customer_id,
#     je.posted_at
#   FROM ledger.accounting_events ae
#   LEFT JOIN ledger.posting_rules pr ON pr.id = ae.posting_rule_id
#   JOIN ledger.journal_entries je ON je.event_id = ae.id
#   JOIN ledger.accounts a ON a.number = je.account_number
#   ORDER BY je.posted_at, je.id;
#
# Expected sequence:
#   3 deposits under v1 (rule_version = 1)
#   3 corrections (rule_version = NULL, event_type = manual.correction.posted)
#
# History is fully preserved. Original entries still point to v1.
# Corrections are separate transactions with no rule.

### Step 12 — Run the diff again to confirm corrections didn't change "differs" status.
GET https://localhost:7100/api/admin/posting-rules/diff/deposit.detected.clean_match

#
# Expected:
#   totalEvents: 3 (the deposits — corrections aren't of this event type)
#   differingEvents: 3 (still — the original entries are immutable)
#
# This is correct! The diff endpoint flags events whose ACTUAL entries differ
# from what the current rule would produce. Those original entries still differ
# because we never edited them. The corrections offset the books in net,
# but the original entries remain wrong.
#
# This is by design. History is sacred.