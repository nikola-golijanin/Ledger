### Reset the system to a clean state
POST https://localhost:7100/api/testing/reset

# Verify journal is empty
# Run this in psql:
# SELECT COUNT(*) FROM ledger.journal_entries;
# SELECT COUNT(*) FROM ledger.transactions;
# SELECT COUNT(*) FROM ledger.accounting_events;
# Expected: 0

