### Step 7 — verify in psql:
# SELECT ae.event_type, je.direction, a.code, je.amount, je.customer_id
# FROM ledger.accounting_events ae
# JOIN ledger.journal_entries je ON je.event_id = ae.id
# JOIN ledger.accounts a ON a.number = je.account_number
# WHERE ae.transaction_id = '$TX_ID'
# ORDER BY ae.occurred_at, je.id;
#
# Expected: 4 entries across 2 events.
# Event 1 (deposit.detected.requires_review): pooling +200, review -200
# Event 2 (deposit.review.approved): review +200, customer.viban -200 (for Alice)
